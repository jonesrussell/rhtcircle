{% extends 'base.html.twig' %}
{% set nav = 'communities' %}

{% block title %}A member counterdraft for Sagamok's election law · RHT Circle{% endblock %}
{% block description %}A complete member counterdraft for a Sagamok leadership selection and accountability law, including independent election administration, member recall and accessible voting.{% endblock %}
{% block og_title %}A member counterdraft for Sagamok's election law{% endblock %}
{% block og_description %}Read and search a complete working law designed to put election authority, amendment power and recall in members' hands.{% endblock %}
{% block body_class %}route-sagamok-member-election-law{% endblock %}

{% block head_styles %}
<style>
.election-law-page{padding:2rem 0 4rem}.election-law-page .cover{margin-bottom:1.5rem}.election-law-page .law-status{display:inline-flex;align-items:center;gap:.5rem;margin:.4rem 0 1rem;padding:.5rem .8rem;border:1px solid #d4aa55;border-radius:999px;background:#fff6df;color:#694b0e;font-weight:700}.election-law-page .law-actions{display:flex;flex-wrap:wrap;gap:.7rem;margin:1.2rem 0}.election-law-page .law-actions a{text-decoration:none}.election-law-page .law-frame{width:100%;height:clamp(760px,82vh,1180px);border:1px solid var(--line,#d7dfdf);border-radius:14px;background:#fff;box-shadow:0 16px 44px rgba(17,47,65,.12)}.election-law-page .law-context{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem;margin:1.3rem 0}.election-law-page .law-context>div{padding:1rem;border:1px solid #d7dfdf;border-radius:10px;background:#f6f9f8}.election-law-page .law-context strong{display:block;margin-bottom:.25rem;color:#123e57}.election-law-page .legal-note{margin:1.3rem 0;padding:1rem 1.15rem;border-left:4px solid #167a76;background:#edf6f4}.election-law-page .frame-fallback{margin:.65rem 0;color:#52666f}@media(max-width:700px){.election-law-page{padding-top:1rem}.election-law-page .law-frame{height:78vh;border-radius:8px}}
