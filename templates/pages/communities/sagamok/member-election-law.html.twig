{% extends 'base.html.twig' %}
{% set nav = 'communities' %}

{% block title %}Proposed Sagamok election law · RHT Circle{% endblock %}
{% block description %}Read and comment on a complete member counterdraft for Sagamok leadership selection and accountability, including independent election administration, accessible voting and member recall.{% endblock %}
{% block og_title %}Proposed Sagamok election law{% endblock %}
{% block og_description %}Draft version 0.2: a complete member counterdraft for review and feedback.{% endblock %}
{% block body_class %}route-sagamok-member-election-law{% endblock %}

{% block head_styles %}
<style>
.election-law-page{--law-ink:#17232c;--law-muted:#5d6d76;--law-navy:#123e57;--law-teal:#167a76;--law-purple:#422078;--law-magenta:#c41d8f;--law-line:#d8e2e1;--law-wash:#f2f7f6;max-width:1180px;margin:0 auto;padding:1.4rem 0 5rem;color:var(--law-ink)}
.election-law-page .crumb{margin:0 0 1rem;font-size:.84rem}.law-hero{position:relative;overflow:hidden;padding:clamp(2rem,6vw,4.8rem);border-radius:20px;background:linear-gradient(125deg,#26154f 0%,#153d59 58%,#167a76 100%);color:#fff}.law-hero:after{content:"";position:absolute;right:-8%;bottom:-42%;width:420px;height:420px;border:1px solid rgba(255,255,255,.15);border-radius:50%;box-shadow:0 0 0 55px rgba(255,255,255,.05),0 0 0 110px rgba(255,255,255,.035)}.law-hero>*{position:relative;z-index:1}.law-kicker{margin:0 0 .65rem;color:#bce6df;font-size:.78rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.law-hero h1{max-width:900px;margin:0;color:#fff;font:600 clamp(2.4rem,5vw,5rem)/.98 Fraunces,Georgia,serif}.law-lede{max-width:760px;margin:1.2rem 0 0;color:#e8f2f1;font-size:clamp(1rem,2vw,1.24rem);line-height:1.55}.law-meta{display:flex;flex-wrap:wrap;gap:.55rem;margin:1.5rem 0 0}.law-meta span{padding:.4rem .7rem;border:1px solid rgba(255,255,255,.35);border-radius:999px;background:rgba(255,255,255,.09);font-size:.82rem;font-weight:700}.law-meta .law-meta-status{border-color:#efd486;background:#4b3510;color:#fff4cf}
.law-toolbar{position:sticky;top:0;z-index:15;display:flex;gap:.55rem;align-items:center;margin:1rem 0 1.5rem;padding:.75rem;border:1px solid var(--law-line);border-radius:12px;background:rgba(255,255,255,.96);box-shadow:0 8px 28px rgba(18,62,87,.09);backdrop-filter:blur(10px)}.law-search{display:flex;flex:1;gap:.45rem}.law-search input{width:100%;min-width:0;padding:.72rem .85rem;border:1px solid #9fb4b8;border-radius:8px;font:inherit}.law-tool{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:.65rem .9rem;border:0;border-radius:8px;background:var(--law-purple);color:#fff;text-decoration:none;font:700 .86rem/1 Inter,sans-serif;cursor:pointer}.law-tool:hover{background:#2e1558;color:#fff}.law-tool--quiet{background:#e9efee;color:#25414c}.law-tool--quiet:hover{background:#dbe7e5;color:#17343e}.law-results{min-width:92px;color:var(--law-muted);font-size:.78rem;text-align:right}
.law-layout{display:grid;grid-template-columns:250px minmax(0,1fr);gap:clamp(1.5rem,4vw,4rem);align-items:start}.law-toc{position:sticky;top:86px;max-height:calc(100vh - 105px);overflow:auto;padding:1rem;border:1px solid var(--law-line);border-radius:12px;background:#fff}.law-toc summary{display:none}.law-toc strong{display:block;margin:.2rem .4rem .55rem;color:var(--law-navy);font-size:.78rem;letter-spacing:.1em;text-transform:uppercase}.law-toc a{display:block;padding:.34rem .45rem;border-left:2px solid transparent;color:#425760;text-decoration:none;font-size:.84rem;line-height:1.3}.law-toc a:hover{border-left-color:var(--law-magenta);color:var(--law-magenta)}.law-toc .toc-break{margin-top:.9rem}
.law-document{min-width:0}.law-intro{margin-bottom:2rem}.law-intro h2{margin:0 0 .75rem;color:var(--law-navy);font:600 clamp(1.7rem,3vw,2.4rem)/1.1 Fraunces,Georgia,serif}.law-intro p{max-width:780px}.law-notice{margin:1rem 0;padding:1rem 1.1rem;border-left:4px solid var(--law-teal);background:var(--law-wash)}.law-notice--constitution{border-left-color:var(--law-magenta);background:#fbf1f8}.law-jumps{display:flex;flex-wrap:wrap;gap:.5rem;margin:1.2rem 0}.law-jumps a{padding:.45rem .7rem;border:1px solid var(--law-line);border-radius:999px;color:var(--law-navy);text-decoration:none;font-size:.84rem;font-weight:700}.law-jumps a:hover{border-color:var(--law-magenta);color:var(--law-magenta)}
.law-document .part{scroll-margin-top:92px;margin:3.3rem 0 0;padding-top:2rem;border-top:1px solid var(--law-line)}.law-document .part:first-of-type{margin-top:0}.law-document h2{margin:0 0 1.1rem;color:var(--law-navy);font:600 clamp(1.9rem,3.2vw,2.8rem)/1.08 Fraunces,Georgia,serif}.law-document h3{scroll-margin-top:92px;margin:2rem 0 .7rem;color:var(--law-navy);font:600 1.25rem/1.25 Fraunces,Georgia,serif}.law-document .s{display:grid;grid-template-columns:48px minmax(0,1fr);gap:.8rem;padding:.5rem 0}.law-document .n{color:var(--law-teal);font-size:.85rem;font-weight:800;text-align:right}.law-document .s p{margin:0}.law-document .sub{margin:.4rem 0 .4rem 3.8rem}.law-document .rule{margin:1rem 0;padding:1rem;background:var(--law-wash);border-left:4px solid var(--law-teal)}.law-document table{display:block;width:100%;overflow-x:auto;border-collapse:collapse;margin:1rem 0;font-size:.88rem}.law-document thead,.law-document tbody{display:table;width:100%;table-layout:fixed}.law-document th,.law-document td{padding:.7rem;border:1px solid var(--law-line);text-align:left;vertical-align:top}.law-document th{background:var(--law-navy);color:#fff}.law-document tr:nth-child(even) td{background:#f7faf9}.law-document .review{margin:2.5rem 0;padding:1rem 1.1rem;border:1px solid #dfc782;border-radius:10px;background:#fff9e9}.law-document .review summary{cursor:pointer;color:#65470d;font-weight:800}.law-document .review li{margin:.35rem 0}.law-feedback{margin:3rem 0 0;padding:1.3rem 1.4rem;border-radius:12px;background:#f8edf6;border:1px solid #e7c6de}.law-feedback h2{font-size:1.55rem}.law-hidden{display:none!important}
@media(max-width:850px){.law-hero{border-radius:14px}.law-toolbar{position:relative;top:auto;flex-wrap:wrap}.law-search{flex-basis:100%}.law-results{margin-left:auto}.law-layout{grid-template-columns:1fr}.law-toc{position:relative;top:auto;max-height:none}.law-toc summary{display:block;cursor:pointer;color:var(--law-navy);font-weight:800}.law-toc[open] summary{margin-bottom:.8rem}.law-toc strong{margin-top:.8rem}.law-document .s{grid-template-columns:42px minmax(0,1fr)}.law-document .sub{margin-left:3.1rem}}
@media(max-width:560px){.election-law-page{padding-top:.75rem}.law-hero{padding:1.6rem 1.25rem}.law-hero h1{font-size:2.35rem}.law-toolbar{padding:.6rem}.law-tool{flex:1;padding:.62rem .5rem}.law-results{display:none}.law-document .s{grid-template-columns:1fr;gap:.1rem;padding:.65rem 0}.law-document .n{text-align:left}.law-document .sub{margin-left:1rem}.law-document thead,.law-document tbody{min-width:620px}}
@media print{.site-head,.site-foot,.rainbow-rule,.crumb,.law-toolbar,.law-toc,#rht-furniture-host,.law-feedback{display:none!important}.election-law-page{max-width:none;padding:0}.law-hero{padding:1.3rem;border-radius:0;background:#fff;color:#17232c;border-bottom:2px solid #123e57}.law-hero h1,.law-kicker,.law-lede{color:#17232c}.law-meta span,.law-meta .law-meta-status{border-color:#888;background:#fff;color:#17232c}.law-layout{display:block}.law-document .part{break-before:page}.law-document .s{break-inside:avoid}}
</style>
{% endblock %}

{% block content %}
<article class="election-law-page">
  <p class="crumb"><a href="/communities">Communities</a> › <a href="/communities/sagamok">Sagamok Anishnawbek</a> › <a href="/communities/sagamok/accountability">Member accountability</a> › Proposed election law</p>

  <header class="law-hero">
    <p class="law-kicker">Working member counterdraft</p>
    <h1>Sagamok Anishnawbek Leadership Selection and Accountability Law</h1>
    <p class="law-lede">A complete proposed election law designed to place election authority with members, separate election administration from Council, protect participation and create a real recall power.</p>
    <div class="law-meta" aria-label="Document status">
      <span>Draft version 0.2</span>
      <span>Updated August 4, 2026</span>
      <span class="law-meta-status">Not official or enacted</span>
    </div>
  </header>

  <div class="law-toolbar" aria-label="Election law tools">
    <div class="law-search"><label class="skip" for="law-search">Search this law</label><input id="law-search" type="search" placeholder="Search the law: recall, privacy, Tribunal..." autocomplete="off"><button class="law-tool law-tool--quiet" id="law-clear" type="button">Clear</button></div>
    <a class="law-tool" href="#part11">Recall</a>
    <a class="law-tool law-tool--quiet" href="#changelog">Changes</a>
    <button class="law-tool law-tool--quiet" type="button" onclick="window.print()">Print</button>
    <span class="law-results" id="law-results" aria-live="polite"></span>
  </div>

  <div class="law-layout">
    <details class="law-toc" open>
      <summary>Contents</summary>
      <strong>Introduction</strong>
      <a href="#overview">What this is</a>
      <a href="#preamble">Preamble</a>
      <strong class="toc-break">The Law</strong>
      <a href="#part1">1. Purpose and interpretation</a>
      <a href="#part2">2. Members' democratic rights</a>
      <a href="#part3">3. Council and leadership</a>
      <a href="#part4">4. Independent election bodies</a>
      <a href="#part5">5. Election calendar and voters list</a>
      <a href="#part6">6. Nominations and candidates</a>
      <a href="#part7">7. Campaign rules</a>
      <a href="#part8">8. Voting and counting</a>
      <a href="#part9">9. Results and recounts</a>
      <a href="#part10">10. Complaints and appeals</a>
      <a href="#part11">11. Member recall</a>
      <a href="#part12">12. Vacancies and by-elections</a>
      <a href="#part13">13. Transparency and privacy</a>
      <a href="#part14">14. Amendment and ratification</a>
      <a href="#part15">15. Transition</a>
      <a href="#schedule">Master deadlines</a>
      <a href="#changelog">Change log</a>
      <a href="#feedback">Send feedback</a>
    </details>

    <div class="law-document" id="law-document">
      <section class="law-intro" id="overview">
        <h2>What this is</h2>
        <p>This is a member-compiled working counterdraft. It starts from Sagamok's earlier election-law package and supplies complete rules where that package left blank thresholds, contradictions or concentrated appointment powers.</p>
        <div class="law-notice"><strong>Legal route.</strong> Sagamok remains under the <a href="https://laws-lois.justice.gc.ca/eng/acts/F-11.65/section-42.html">First Nations Elections Act</a>. Formal enactment requires Council's section 42 resolution, publication of the complete code, approval through the required secret member vote and a federal removal order.</div>
        <div class="law-notice law-notice--constitution"><strong>Constitutional relationship.</strong> <a href="https://www.sagamokanishnawbek.com/meeting-minutes/chief-and-council-meeting-september-13-2022">Sagamok's September 13, 2022 Council minutes</a> record that an election law needs a constitutional home. This draft is limited to leadership selection and accountability. It is intended to operate under a future member-ratified Sagamok constitution, which would prevail if the two conflict.</div>
        <nav class="law-jumps" aria-label="Key provisions">
          <a href="#part4">Independent administration</a>
          <a href="#part6">Open participation</a>
          <a href="#part11">Member recall</a>
          <a href="#part14">Member-controlled amendments</a>
        </nav>
      </section>

      {% include 'components/sagamok-election-law-body.html.twig' %}

      <section class="law-feedback" id="feedback">
        <h2>Send feedback</h2>
        <p>Note the section number and say what should be kept, changed or added. <a href="/contact">Send feedback through the Circle contact form</a>. Feedback informs the next counterdraft; it is not a petition signature or vote.</p>
      </section>
    </div>
  </div>
</article>
{% endblock %}

{% block scripts %}
<script>
(() => {
  const input = document.getElementById('law-search');
  const clear = document.getElementById('law-clear');
  const status = document.getElementById('law-results');
  const toc = document.querySelector('.law-toc');
  const sections = [...document.querySelectorAll('#law-document > section')];
  if (window.matchMedia('(max-width: 850px)').matches) toc.removeAttribute('open');
  const run = () => {
    const query = input.value.trim().toLowerCase();
    let matches = 0;
    sections.forEach((section) => {
      const visible = !query || section.innerText.toLowerCase().includes(query);
      section.classList.toggle('law-hidden', !visible);
      if (visible && query) matches += 1;
    });
    status.textContent = query ? `${matches} section${matches === 1 ? '' : 's'}` : '';
  };
  input.addEventListener('input', run);
  clear.addEventListener('click', () => { input.value = ''; run(); input.focus(); });
})();
</script>
{% endblock %}
