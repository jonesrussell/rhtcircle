{% set plan_key = 'sources' %}{% set plan_short = 'Source record' %}{% set plan_eyebrow = 'Evidence and open fields' %}
{% set plan_title = 'The public record behind the plan' %}
{% set plan_description = 'Separate established baselines from open fields so members can see what is known, what needs updating and which records would answer the remaining questions.' %}
{% set plan_status = 'Source register' %}
{% block plan_content %}
<section><header><p class="plan-kicker">Financial baseline</p><h2>Figures used in the plan.</h2></header><div class="plan-table"><table><thead><tr><th>Baseline</th><th>Value</th><th>Date</th><th>Source</th></tr></thead><tbody><tr><td>Audit opinion</td><td>Clean, unmodified opinion</td><td>Year ended March 31, 2025</td><td>FY2025 audited consolidated financial statements</td></tr><tr><td>Trust market value</td><td>$219,001,971</td><td>December 31, 2025</td><td>Nation-published BMO quarterly investment report</td></tr><tr><td>Loans due from Government Business Enterprises</td><td>$96,972,955</td><td>March 31, 2025</td><td>FY2025 audit, Note 14</td></tr><tr><td>Long-term debt</td><td>$100,516,135</td><td>March 31, 2025</td><td>FY2025 audited consolidated financial statements</td></tr></tbody></table></div></section>
<section><header><p class="plan-kicker">Housing baseline</p><h2>Directions recorded, status still required.</h2></header><div class="plan-table"><table><thead><tr><th>Record</th><th>What it establishes</th><th>What remains open</th></tr></thead><tbody><tr><td>April 22, 2025 Council minutes, item 8(a)</td><td>A ten-year objective of 422 homes and a historical conditional package involving lots, homes, repairs and foundations</td><td>Final funding, procurement, construction and completion status</td></tr><tr><td>October 28, 2025 Council minutes, Motion 2025/10 #17</td><td>Direction to plan and procure up to 30 homes in 2026 and 2027, with budgets, designs, locations and contracts to return</td><td>The returned package, approved budget, funding source, locations, awards and delivery dates</td></tr><tr><td>October 28, 2025 water discussion</td><td>Water flow and pressure were described as critical constraints alongside leak-detection work</td><td>Current capacity assessment, completed repairs and effect on new housing</td></tr></tbody></table></div></section>
<section><header><p class="plan-kicker">Open records</p><h2>Documents needed to cost and govern the plan.</h2></header><div class="plan-grid"><div class="plan-card"><h3>Government</h3><ul><li>Current organization chart</li><li>Committee mandates and membership</li><li>Records-access and appeal process</li><li>Conflict disclosures and recusal process</li></ul></div><div class="plan-card"><h3>Community wealth</h3><ul><li>Trust instrument and adopted policies</li><li>Current debt and guarantee schedule</li><li>Company-loan schedules and repayments</li><li>Capital-allocation and risk policies</li></ul></div><div class="plan-card"><h3>Housing and infrastructure</h3><ul><li>Current needs and wait-list baseline</li><li>Returned 2026 and 2027 housing package</li><li>Serviced-lot and water-capacity studies</li><li>Active contract and project schedule</li></ul></div><div class="plan-card"><h3>Programs and workforce</h3><ul><li>Current service map and standards</li><li>Staffing, vacancies and capacity</li><li>Program costs and funding terms</li><li>Existing outcome and wait-time data</li></ul></div></div></section>
<section><header><p class="plan-kicker">Direct source links</p><h2>Start here.</h2></header><div class="plan-grid"><a class="plan-card" href="https://www.sagamokanishnawbek.com/annual-report-financial-statements/2025-annual-report" target="_blank" rel="noopener"><h3>2025 annual report and financial statements</h3><p>Nation website</p></a><a class="plan-card" href="https://www.sagamokanishnawbek.com/meeting-minutes/meeting-minutes" target="_blank" rel="noopener"><h3>Chief and Council minutes</h3><p>Nation website</p></a><a class="plan-card" href="https://partii-partiii.fng.ca/fng-gpn-ii-iii/pii/en/item/479633/index.do" target="_blank" rel="noopener"><h3>Financial Administration Law, 2020</h3><p>First Nations Gazette</p></a><a class="plan-card" href="/standard/records-request"><h3>Worked records request</h3><p>RHT Circle member tool</p></a></div></section>
<section class="plan-decision"><h2>Evidence rule</h2><p>A missing value stays open. A direction is not reported as a completion. A clean result is stated plainly. Every changing baseline carries a date and source.</p></section>
