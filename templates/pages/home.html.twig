{% extends 'base.html.twig' %}
{% set nav = 'home' %}

{% block title %}RHT Circle · Member-led news across 21 Nations{% endblock %}
{% block description %}Member-led news, public records and practical resources across the 21 Robinson Huron Treaty First Nations.{% endblock %}
{% block og_description %}News, public records, community knowledge and practical resources across the 21 Robinson Huron Treaty First Nations.{% endblock %}
{% block body_class %}route-home{% endblock %}
{% block main_class %}wrap wrap--wide{% endblock %}

{% block hero %}
<section class="home-hero">
  <div class="wrap wrap--wide">
    <div class="home-hero__grid">
      <div>
        <p class="eyebrow">Member-led · sourced · across 21 Nations</p>
        <h1>News and public records members can use.</h1>
        <p class="lead">RHT Circle connects community reporting, the Treaty, land and water decisions, public records and practical help across Robinson Huron Treaty territory.</p>
        <div class="btn-row">
          <a class="btn" href="/news">Read the latest</a>
          <a class="btn btn--alt" href="/communities">Find your Nation</a>
        </div>
      </div>

      {% if featured_articles is not empty %}
        {% set lead_article = featured_articles[0] %}
        <a class="home-lead-story" href="{{ lead_article.href }}">
          <span class="home-lead-story__label">{{ lead_article.section }}</span>
          <strong>{{ lead_article.title }}</strong>
          <span>{{ lead_article.summary }}</span>
          <span class="home-lead-story__go">{{ lead_article.action }}</span>
        </a>
      {% endif %}
    </div>

    <form id="rht-ask-hero" class="hero-ask home-ask" role="search">
      <label class="hero-ask__label" for="rht-ask-hero-input">Aanii. Ask this resource a question</label>
      <div class="hero-ask__row">
        <input id="rht-ask-hero-input" type="text" autocomplete="off" maxlength="500" placeholder="What is the settlement? Find my Nation. Where can I get help?">
        <button type="submit">Ask</button>
      </div>
      <p class="hero-ask__note">Plain, cited answers from RHT Circle’s pages. This is a community resource, not a Nation or the Litigation Fund.</p>
    </form>
  </div>
</section>
{% endblock %}

{% block content %}
  <section class="home-section">
    <div class="home-section__head">
      <div>
        <p class="eyebrow">Current public record</p>
        <h2>Across the territory</h2>
      </div>
      <a href="/news">All news and reporting</a>
    </div>
    <div class="news-grid home-news-grid">
      {% for story in stories|slice(0, 3) %}
        {% include 'components/news_card.html.twig' with { story: story, nation_names: nation_names } only %}
      {% endfor %}
    </div>
  </section>

  <section class="home-community-band">
    <div class="home-community-band__intro">
      <p class="eyebrow">One Treaty, 21 community desks</p>
      <h2>Start with the Nation you know.</h2>
      <p>Every community has a sourced profile, its official public updates and reporting connected to that Nation. Local knowledge makes each desk stronger.</p>
      <div class="btn-row">
        <a class="btn" href="/communities">See all 21 Nations</a>
        <a class="btn btn--alt" href="/get-involved">Help keep one current</a>
      </div>
    </div>
    <div class="home-region-list">
      {% for region_key, communities in communities_by_region %}
        <a href="/communities#{{ region_key }}">
          <strong>{{ regions[region_key] }}</strong>
          <span>{{ communities|length }} Nations</span>
        </a>
      {% endfor %}
    </div>
  </section>

  <section class="home-section">
    <div class="home-section__head">
      <div>
        <p class="eyebrow">Use the site</p>
        <h2>Find the right doorway.</h2>
      </div>
    </div>
    <div class="tile-grid home-doorways">
      {% include 'components/tile_card.html.twig' with {
        tag: 'Understand',
        title: 'The Treaty and settlement',
        desc: 'The 1850 promise, the annuity, the settlement, distribution models and what is still being decided.',
        go: 'Start with the Treaty',
        href: '/treaty'
      } only %}
      {% include 'components/tile_card.html.twig' with {
        tag: 'Follow',
        title: 'Land and water',
        desc: 'Energy, mining, infrastructure, claims and environmental decisions across the territory.',
        go: 'See the project map',
        href: '/land'
      } only %}
      {% include 'components/tile_card.html.twig' with {
        tag: 'Use',
        title: 'Accountability tools',
        desc: 'Public-record questions, records requests and a shared transparency standard members can adapt locally.',
        go: 'Open the standard',
        href: '/standard'
      } only %}
      {% include 'components/tile_card.html.twig' with {
        tag: 'Get help',
        title: 'Services and safety',
        desc: 'Practical service directories, crisis support, education help and community-safety resources.',
        go: 'Find resources',
        href: '/resources'
      } only %}
    </div>
  </section>

  <section class="home-contribute">
    <div>
      <p class="eyebrow">The Circle is a contributor network</p>
      <h2>Bring the community or subject you know.</h2>
      <p>You do not need a finished article. Help keep a Nation page current, follow a beat, bring a public record, review sources or work with an editor on a piece.</p>
    </div>
    <a class="btn" href="/get-involved">See how to contribute</a>
  </section>
{% endblock %}
