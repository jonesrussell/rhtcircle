{% extends 'base.html.twig' %}
{% set nav = 'circle' %}

{% block title %}Contribute · Help cover all 21 Nations · Robinson Huron Treaty{% endblock %}
{% block description %}Help RHT Circle keep all 21 community pages current as a community steward, beat contributor, writer, source reviewer or local accountability contact.{% endblock %}
{% block og_description %}Members and people with community knowledge can help keep the 21 Nation pages current, follow a subject, verify sources or contribute a story.{% endblock %}

{% block hero %}
<section class="hero">
  <div class="wrap wrap--wide">
    <p class="eyebrow">A member-led publication across 21 Nations</p>
    <h1>Help build the Circle.</h1>
    <p class="lead">You do not have to arrive with a finished article. Bring the community you know, an issue you follow, a public record, a correction, a question or a piece of writing. We can shape and verify it together.</p>
  </div>
</section>
{% endblock %}

{% block content %}
  <h2>Five useful ways to contribute</h2>
  <div class="tile-grid">
    {% include 'components/tile_card.html.twig' with {
      tag: 'One Nation',
      title: 'Community steward',
      desc: 'Help keep one Nation page current. Watch public notices and local reporting, suggest corrections, and tell us which issues deserve sustained attention.',
      go: 'Choose your community',
      href: '/communities'
    } only %}
    {% include 'components/tile_card.html.twig' with {
      tag: 'One subject, across Nations',
      title: 'Beat contributor',
      desc: 'Follow a subject such as Elders, health, housing, land, language, youth, governance, culture or the settlement across more than one community.',
      go: 'Make contact',
      href: '/contact'
    } only %}
    {% include 'components/tile_card.html.twig' with {
      tag: 'Reporting and commentary',
      title: 'Writer',
      desc: 'Bring a draft, notes or an idea. We can help with structure, source checks, plain-language editing, links, layout and publication.',
      go: 'Make contact',
      href: '/contact'
    } only %}
    {% include 'components/tile_card.html.twig' with {
      tag: 'Accuracy',
      title: 'Source reviewer',
      desc: 'Check dates, names, documents, links and what a source does or does not establish. Quiet editorial work matters as much as a byline.',
      go: 'Make contact',
      href: '/contact'
    } only %}
    {% include 'components/tile_card.html.twig' with {
      tag: 'Member accountability',
      title: 'Local Circle contact',
      desc: 'Help members in your Nation use the shared transparency standard and keep track of what their Council makes public in response.',
      go: 'Read the shared standard',
      href: '/standard'
    } only %}
  </div>

  <h2>How a contribution moves</h2>
  <ol>
    <li><strong>Start with what you have.</strong> A message, link, document, screenshot, voice note, rough draft or finished piece is enough.</li>
    <li><strong>Choose the lane.</strong> It may update a community page, become a short news item, open a continuing beat or develop into a full article.</li>
    <li><strong>Check the record.</strong> Facts are linked to public sources. First-hand experience is clearly presented as experience or opinion.</li>
    <li><strong>Edit together.</strong> The contributor reviews the wording, headline, byline and final page before publication.</li>
    <li><strong>Keep it alive.</strong> Community pages and beats are updated as the public record changes.</li>
  </ol>

  <div class="card card--magenta">
    <h3>Your name and role are your choice</h3>
    <p>You can publish under your name, use an agreed byline, contribute without a public byline, or begin with a private conversation. Nothing is posted as your work until you have reviewed it.</p>
  </div>

  <h2>What RHT Circle supplies</h2>
  <ul>
    <li>Editing, research support, source checks and links.</li>
    <li>A permanent home on the relevant community and topic pages.</li>
    <li>Readable page design, automatic social sharing images and corrections when the record changes.</li>
    <li>Clear separation between verified fact, first-hand account, analysis and opinion.</li>
  </ul>

  <div class="btn-row">
    <a class="btn" href="/contact">Start a conversation</a>
    <a class="btn btn--alt" href="/communities">Choose a community</a>
  </div>
{% endblock %}
