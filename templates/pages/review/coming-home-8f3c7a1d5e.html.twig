  <style>
    :root {
      --ink: #17251f;
      --forest: #173d30;
      --forest-light: #285a46;
      --cedar: #a34931;
      --gold: #e3b657;
      --cream: #f6f0e3;
      --paper: #fffdf8;
      --muted: #5e6862;
      --line: #dcd4c4;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--ink);
      background: var(--cream);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.6;
    }
    a { color: inherit; }
    .shell { width: min(1040px, calc(100% - 40px)); margin: 0 auto; }
    .private {
      padding: 10px 20px;
      color: rgba(255,255,255,.78);
      background: #10271f;
      text-align: center;
      font-size: .74rem;
      font-weight: 750;
      letter-spacing: .09em;
      text-transform: uppercase;
    }
    header {
      padding: 22px 0;
      border-bottom: 1px solid rgba(23,37,31,.12);
      background: rgba(246,240,227,.9);
    }
    .brand { display: flex; align-items: center; gap: 12px; font-size: .79rem; font-weight: 850; letter-spacing: .11em; }
    .mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; color: white; background: var(--cedar); font-family: Georgia, serif; font-size: 1.25rem; }

    .hero {
      min-height: 700px;
      display: grid;
      align-content: center;
      padding: 90px 0 110px;
    }
    .eyebrow { margin: 0 0 20px; color: var(--cedar); font-size: .78rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
    h1, h2 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-weight: 500; line-height: .98; letter-spacing: -.045em; }
    h1 { max-width: 920px; font-size: clamp(4.4rem, 11vw, 8.7rem); }
    h2 { font-size: clamp(2.65rem, 6vw, 5.1rem); }
    .hero-copy { max-width: 750px; margin: 36px 0 0; color: var(--muted); font-family: Georgia, serif; font-size: clamp(1.25rem, 2.4vw, 1.8rem); line-height: 1.45; }

    .story { padding: 100px 0; color: white; background: var(--forest); }
    .story-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 70px; align-items: start; }
    .story-label { color: var(--gold); }
    blockquote { margin: 0; font-family: Georgia, serif; font-size: clamp(1.85rem, 4.1vw, 3.5rem); line-height: 1.22; letter-spacing: -.025em; }
    .note { max-width: 680px; margin-top: 28px; color: rgba(255,255,255,.64); font-size: .85rem; }

    .turn { padding: 100px 0; }
    .turn-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; align-items: center; }
    .turn-copy p { color: var(--muted); font-size: 1.05rem; }
    .law-card { padding: 40px; border: 1px solid var(--line); border-radius: 22px; background: var(--paper); box-shadow: 0 22px 55px rgba(31,49,40,.1); }
    .law-card .year { color: var(--cedar); font-size: .78rem; font-weight: 850; letter-spacing: .11em; }
    .law-card strong { display: block; margin: 15px 0; font-family: Georgia, serif; font-size: 1.8rem; line-height: 1.2; }
    .law-card p { margin: 0; color: var(--muted); }

    .question { padding: 90px 0; color: white; background: var(--cedar); }
    .question h2 { max-width: 900px; }
    .question p { max-width: 760px; margin: 28px 0 0; color: rgba(255,255,255,.78); font-size: 1.1rem; }

    .idea { padding: 110px 0; }
    .idea-intro { max-width: 760px; margin-top: 28px; color: var(--muted); font-size: 1.1rem; }
    .sequence { margin-top: 60px; border-top: 1px solid var(--line); }
    .sequence-row { display: grid; grid-template-columns: 75px 1fr; gap: 25px; padding: 30px 0; border-bottom: 1px solid var(--line); }
    .sequence-number { color: var(--cedar); font-family: Georgia, serif; font-size: 2rem; }
    .sequence-row strong { display: block; font-family: Georgia, serif; font-size: 1.55rem; font-weight: 500; }
    .sequence-row p { margin: 8px 0 0; color: var(--muted); }

    .recording { padding: 90px 0; background: #e9e1d2; }
    .recording-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 25px; margin-top: 45px; }
    .clip { overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: var(--paper); }
    video { display: block; width: 100%; aspect-ratio: 1280 / 560; background: #101713; }
    .clip-copy { padding: 24px; }
    .clip-copy small { color: var(--cedar); font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
    .clip-copy h3 { margin: 8px 0; font-family: Georgia, serif; font-size: 1.55rem; font-weight: 500; }
    .clip-copy p { margin: 0; color: var(--muted); font-size: .9rem; }

    .close { padding: 120px 0; text-align: center; }
    .close h2 { max-width: 870px; margin: 0 auto; }
    .close p { max-width: 700px; margin: 30px auto 0; color: var(--muted); font-size: 1.1rem; }
    .sources { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 35px; }
    .sources a { padding: 9px 14px; border: 1px solid var(--line); border-radius: 99px; color: var(--forest); text-decoration: none; font-size: .78rem; font-weight: 750; }
    footer { padding: 28px 0 45px; border-top: 1px solid var(--line); color: var(--muted); font-size: .76rem; text-align: center; }

    @media (max-width: 760px) {
      .hero { min-height: 600px; padding: 70px 0 85px; }
      .story-grid, .turn-grid, .recording-grid { grid-template-columns: 1fr; gap: 38px; }
      .story, .turn, .idea, .recording { padding: 75px 0; }
      .sequence-row { grid-template-columns: 48px 1fr; gap: 15px; }
      .law-card { padding: 28px; }
    }

    @media print {
      .private, header, video { display: none; }
      body { background: white; }
      .hero { min-height: auto; }
      section { break-inside: avoid; }
    }
