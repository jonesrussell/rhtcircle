          <div class="sticky">
            <div class="fact-card dark">
              <div class="fact-label">Due by March 2026</div>
              <div class="fact-number">$500,000 + 4%</div>
              <div class="fact-text">No repayment, extension or current balance is recorded in the minutes held through May 19.</div>
            </div>

            <div class="fact-card">
