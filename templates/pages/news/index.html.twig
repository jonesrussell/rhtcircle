{% extends 'base.html.twig' %}
{% set nav = 'news' %}

{% block title %}News and reporting | Robinson Huron Treaty{% endblock %}
{% block description %}Original RHT Circle reporting and a hand-reviewed digest of recent Robinson Huron Treaty news from community, regional and official sources.{% endblock %}
{% block og_description %}Original member-led reporting, plus recent news and official updates from across Robinson Huron Treaty territory.{% endblock %}
{% block body_class %}route-news{% endblock %}
{% block main_class %}wrap wrap--wide{% endblock %}

{% block content %}
  <header class="news-head">
    <p class="news-kicker">Across the 21 Nations</p>
    <h1>News and reporting</h1>
    <p class="lead">Original reporting from RHT Circle, plus recent coverage and official updates from across Robinson Huron Treaty territory.</p>
  </header>

  {% include 'components/news_feature.html.twig' with {
    story: {
      href: '/news/sagamok-membership-before-trespass',
      image: {
        src: '/images/news/membership-before-trespass/laws-out-of-order-warning.png',
        width: 1672,
        height: 941,
        alt: 'The Trespass By-law draft shown before an unreleased Membership Law.'
      },
      section: 'RHT Circle analysis',
      date: 'July 26, 2026',
      title: 'Membership should come before trespass',
      deck: 'Sagamok is moving ahead with an enforcement by-law before members have seen the new membership law that will decide who counts as a member.',
      author: 'Russell Jones',
      action: 'Read the analysis'
    }
  } only %}

  <div class="news-section-head">
    <h2>RHT Circle reporting</h2>
    <p>Original reporting and analysis built from the public record.</p>
  </div>

  <div class="news-grid">
    {% include 'components/news_card.html.twig' with {
      story: {
        url: '/news/waasmoowin-deal-public-record',
        topic: 'Analysis',
        date: 'July 27, 2026',
        date_iso: '2026-07-27',
        title: "Who holds Sagamok's Waasmoowin roles?",
        summary: "The public record identifies four Sagamok role lanes. The Nation's ownership, borrowing, procurement and return terms remain unseen.",
        source: 'RHT Circle',
        nations: ['sagamok'],
        internal: true
      }
    } only %}

    {% include 'components/news_card.html.twig' with {
      story: {
        url: '/news/aging-well-starts-before-long-term-care',
        topic: 'Commentary',
        date: 'July 26, 2026',
        date_iso: '2026-07-26',
        title: 'Aging well starts before long-term care',
        summary: 'Long-term care may be necessary for some people. Aging well begins much earlier, in the homes, relationships and communities that help people remain well and connected.',
        source: 'RHT Circle',
        nations: ['whitefish-river', 'sagamok', 'wiikwemkoong'],
        internal: true
      }
    } only %}

    {% include 'components/news_card.html.twig' with {
      story: {
        url: '/news/inside-sagamoks-gr-truss-deal',
        topic: 'Investigation',
        date: 'July 25, 2026',
        date_iso: '2026-07-25',
        title: "Inside Sagamok's GR Truss deal",
        summary: 'A $100 purchase, $900,000 in Council approvals and one unanswered repayment question.',
        source: 'RHT Circle',
        nations: ['sagamok'],
        internal: true
      }
    } only %}
  </div>

  <div class="news-section-head">
    <h2>Recent across the territory</h2>
    <p>Selected for direct relevance to Treaty members. The full story remains with the original publisher.</p>
  </div>

  <div class="news-grid">
    {% for story in stories %}
      {% include 'components/news_card.html.twig' with { story: story } only %}
    {% endfor %}
  </div>

  <section class="news-community-desks">
    <div class="news-section-head">
      <h2>Community desks</h2>
      <p>Every Nation has a sourced profile and a place for current public updates. Choose a community, or help keep its page current.</p>
    </div>
    {% for region_key, communities in communities_by_region %}
      <h3>{{ regions[region_key] }}</h3>
      <div class="news-community-links">
        {% for nation in communities %}
          <a href="/communities/{{ nation.slug }}">{{ nation.name }}</a>
        {% endfor %}
      </div>
    {% endfor %}
    <div class="btn-row">
      <a class="btn" href="/get-involved">Help with a community desk</a>
      <a class="btn btn--alt" href="/communities">See all 21 profiles</a>
    </div>
  </section>

  <p class="news-note"><strong>About this digest:</strong> RHT Circle writes the short summaries and links directly to the original reporting or official notice. Inclusion is not endorsement. Dates shown are publication dates. Last reviewed July 26, 2026.</p>
{% endblock %}
