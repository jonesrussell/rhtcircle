{
    "name": "jonesrussell/rhtcircle",
    "description": "Independent member-led news and resources across the 21 Robinson Huron Treaty Nations",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.5",
        "ext-pdo_sqlite": "*",
        "ext-sqlite3": "*",
        "symfony/dotenv": "^8.0",
        "waaseyaa/ai-agent": "0.1.0-alpha.305",
        "waaseyaa/anokii": "^0.1.0-alpha.13",
        "waaseyaa/framework": "0.1.0-alpha.305",
        "waaseyaa/mcp": "0.1.0-alpha.305"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "config": {
        "optimize-autoloader": true,
        "process-timeout": 0,
        "sort-packages": true
    },
    "scripts": {
        "audit-site": [
            "@check",
            "@php vendor/bin/waaseyaa app:ingest --dry-run"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/dev"
        ],
        "post-create-project-cmd": [
            "php bin/post-create-setup.php"
        ],
        "test": "@php vendor/bin/phpunit",
        "lint": [
            "@php bin/lint-copy.php",
            "@php bin/lint-signature-counts.php"
        ],
        "agents:install": "@php vendor/bin/waaseyaa bimaaji:install --client=codex,claude --no-interaction",
        "check": [
            "@composer validate --no-check-publish",
            "@analyse",
            "@lint",
            "@test"
        ],
        "analyse": "@php vendor/bin/phpstan analyse --no-progress"
    },
    "extra": {
        "waaseyaa": {
            "permissions": {
                "access anokii admin": {
                    "title": "Access Anokii administration",
                    "description": "Use the site's Anokii administration interface."
                }
            },
            "providers": [
                "App\\Provider\\FieldAccessClassificationProvider",
                "App\\Provider\\RenderingServiceProvider",
                "App\\Provider\\AppServiceProvider",
                "App\\Provider\\PublishingServiceProvider",
                "App\\Provider\\CmsContentServiceProvider",
                "App\\Provider\\SagamokMonitorServiceProvider",
                "App\\Provider\\AnokiiContentServiceProvider",
                "Anokii\\Provider\\CoIntelligenceServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
